# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable (npx impeccable install) -- machine/OS-arch-specific local
# tooling (includes a ~12MB compiled binary per platform, duplicated across
# every detected harness) and machine-local hook wiring. Not meant to be
# committed -- re-run `npx impeccable install` on any other machine/clone.
.claude/settings.local.json
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
.github/hooks/impeccable.json
.github/skills/impeccable/
.github/agents/impeccable-*.agent.md
