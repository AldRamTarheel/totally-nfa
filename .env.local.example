# Copy this file to .env.local and fill in real values.
# See README.md "Manual setup steps" for exactly where to get each one.

# --- Supabase (https://supabase.com — free tier project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (https://aistudio.google.com/apikey — free tier API key) ---
GEMINI_API_KEY=
# Optional override; defaults to "gemini-flash-lite-latest" if unset.
GEMINI_MODEL=gemini-flash-lite-latest

# --- ntfy.sh (no signup required — just pick a hard-to-guess topic name) ---
NTFY_DEFAULT_TOPIC=totally-nfa-alerts-CHANGE-ME

# --- Cron auth (generate with: openssl rand -hex 32) ---
CRON_SECRET=

# --- Macro proxy tickers used by the Macro Agent ---
MACRO_TICKERS=QQQ,GLD,USO
